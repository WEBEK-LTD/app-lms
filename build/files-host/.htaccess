# files.yallapp.com.tr: every request goes through index.php, which checks the signature.
Options -Indexes
RewriteEngine On
RewriteRule ^config(\.sample)?\.php$ - [F,L]
RewriteCond %{REQUEST_URI} !^/index\.php$
# AutoSSL validates the certificate through /.well-known.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ index.php [L,QSA]
