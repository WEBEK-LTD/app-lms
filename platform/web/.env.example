# yallapp.com.tr platform. Copy to .env.local for local runs; set the same
# names in Netlify (Site configuration › Environment variables) for production.
# Never commit real values.

# Public address of the site, no trailing slash. Used in emails and signed links.
APP_URL=http://localhost:3000

# Data store: "mysql" (production) or "memory" (local runs and tests only; refused on Netlify).
YALLAPP_DATA=memory

# MySQL on host.webek.org. A dedicated user with rights on this database only.
# mysql://USER:PASSWORD@host.webek.org:3306/DATABASE
DATABASE_URL=
# TLS is required. "disabled" is only accepted outside Netlify, for a local MySQL.
DATABASE_SSL=required
# The database server's CA: "host.webek.org" uses the one bundled in
# src/lib/db/known-cas.json. Or a PEM certificate (newlines may be written as \n).
DATABASE_CA=host.webek.org

# 32+ random characters each. Generate with: openssl rand -base64 48
SESSION_SECRET=
SIGNING_SECRET=
# 32 bytes as 64 hex characters (openssl rand -hex 32). Encrypts license keys and store API keys.
# To change it, put the old one in ENCRYPTION_KEY_OLD until Admin › Watching says every value moved (79.2).
ENCRYPTION_KEY=
# Previous keys, comma-separated, while the frequent job moves their values to ENCRYPTION_KEY.
ENCRYPTION_KEY_OLD=

# Comma-separated. These people are super admins. The first sign-in is
# "Forgot password?" with one of these emails, which creates the account.
SUPER_ADMIN_EMAILS=info@yallapp.com.tr

# Memory mode only: creates the super admins above with this password at start-up.
YALLAPP_SEED_ADMIN_PASSWORD=

# Bearer token for the build pipeline API (docs/api/pipeline.yaml). openssl rand -hex 32
BUILD_PIPELINE_TOKEN=

# 13.4 The daily job: the token the Netlify scheduled function sends to
# POST /api/internal/daily (plan-ending reminders, app users notices, downgrades).
# 32+ characters: openssl rand -hex 32. Unset: the route refuses every request.
INTERNAL_JOB_SECRET=

# Optional: starts the build workflow as soon as a build is queued, instead of
# waiting up to 10 minutes for its schedule. Fine-grained GitHub token for this
# repository only, permission "Actions: Read and write".
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=WEBEK-LTD/app-lms

# Build files (APK, AAB, IPA, upload key, store assets) on files.yallapp.com.tr.
# Links on this origin are signed when a page shows them and expire after 15 minutes.
FILES_BASE_URL=https://files.yallapp.com.tr
# 32+ random characters, the same value as on files.yallapp.com.tr. openssl rand -hex 32
# Without it, download links show "Downloads aren't configured yet".
FILES_SIGNING_SECRET=

# Outgoing email. Without SMTP_HOST, emails are printed to the server log in
# development and dropped (with a warning) in production.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Yallapp <info@yallapp.com.tr>
# Memory mode only, without SMTP: also writes each email to this folder as JSON
# (the end-to-end tests read them).
# YALLAPP_MAIL_DIR=.data/mail

# File storage: Netlify Blobs on Netlify; a local folder elsewhere.
# YALLAPP_BLOBS=fs
# YALLAPP_BLOBS_DIR=.data/blobs

# Owners' videos, pictures and PDFs (Media, roadmap 51): the media gate on our
# host (deploy/media-host), at the address Apache answers, with the secret in
# its config.php. Unset on Netlify: no uploads. Elsewhere, without them, a local
# folder served by the platform's own /media route.
# MEDIA_BASE_URL=https://yallapp.com.tr/media
# MEDIA_SIGNING_SECRET=
# YALLAPP_MEDIA=fs
# YALLAPP_MEDIA_DIR=.data/media

# Yallapp Business (roadmap 58), the owners' own app: pushes to the owners'
# phones come from its own Firebase project. The service account key JSON on
# one line (Firebase console › Project settings › Service accounts › Generate
# new private key); never commit it. Optional: Huawei Push Kit's app ID and
# secret for Huawei phones without Google Play. Unset: the Owner API works and
# no pushes go out.
OWNER_PUSH_FIREBASE_SERVICE_ACCOUNT=
# OWNER_PUSH_HMS_APP_ID=
# OWNER_PUSH_HMS_APP_SECRET=
# Local runs and tests only (never on Netlify): each owner push also written
# here as JSON (the end-to-end tests read them).
# YALLAPP_OWNER_PUSH_DIR=.data/owner-push

# yallapp.com.tr is served through a reverse proxy on host.webek.org
# (deploy/apache-proxy.conf) that sends the visitor's IP with this secret.
# The same value goes in that file. openssl rand -hex 32
TRUSTED_PROXY_SECRET=

# Hosted API sign-in codes (apps on the hosted API, roadmap 8.3).
# OTP_SENDER: whatsapp (WhatsApp Cloud API with an approved authentication
# template), webhook (POST to our own gateway, signed with OTP_WEBHOOK_SECRET),
# or log (local runs only; the default in memory mode).
OTP_SENDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=yallapp_code
WHATSAPP_OTP_LANGUAGE=en
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=
