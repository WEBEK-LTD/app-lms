# yallapp.com.tr platform. Copy to .env.local for local runs; set the same
# names in Netlify (Site configuration › Environment variables) for production.
# Never commit real values.

# Public address of the site, no trailing slash. Used in emails and signed links.
APP_URL=http://localhost:3000

# Data store: "mysql" (production) or "memory" (local runs and tests only; refused on Netlify).
YALLAPP_DATA=memory

# MySQL on host.webek.org. A dedicated user with rights on this database only.
# mysql://USER:PASSWORD@host.webek.org:3306/DATABASE
DATABASE_URL=
# TLS is required. "disabled" is only accepted outside Netlify, for a local MySQL.
DATABASE_SSL=required
# The database server's CA: "host.webek.org" uses the one bundled in
# src/lib/db/known-cas.json. Or a PEM certificate (newlines may be written as \n).
DATABASE_CA=host.webek.org

# 32+ random characters each. Generate with: openssl rand -base64 48
SESSION_SECRET=
SIGNING_SECRET=
# 32 bytes as 64 hex characters (openssl rand -hex 32). Encrypts license keys and store API keys.
# Changing it makes everything encrypted with the old key unreadable.
ENCRYPTION_KEY=

# Comma-separated. These people are super admins. The first sign-in is
# "Forgot password?" with one of these emails, which creates the account.
SUPER_ADMIN_EMAILS=info@yallapp.com.tr

# Memory mode only: creates the super admins above with this password at start-up.
YALLAPP_SEED_ADMIN_PASSWORD=

# Bearer token for the build pipeline API (docs/api/pipeline.yaml). openssl rand -hex 32
BUILD_PIPELINE_TOKEN=

# Build files (APK, AAB, IPA, upload key, store assets) on files.yallapp.com.tr.
# Links on this origin are signed when a page shows them and expire after 15 minutes.
FILES_BASE_URL=https://files.yallapp.com.tr
# 32+ random characters, the same value as on files.yallapp.com.tr. openssl rand -hex 32
# Without it, download links show "Downloads aren't configured yet".
FILES_SIGNING_SECRET=

# Outgoing email. Without SMTP_HOST, emails are printed to the server log in
# development and dropped (with a warning) in production.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Yallapp <info@yallapp.com.tr>

# File storage: Netlify Blobs on Netlify; a local folder elsewhere.
# YALLAPP_BLOBS=fs
# YALLAPP_BLOBS_DIR=.data/blobs

# yallapp.com.tr is served through a reverse proxy on host.webek.org
# (deploy/apache-proxy.conf) that sends the visitor's IP with this secret.
# The same value goes in that file. openssl rand -hex 32
TRUSTED_PROXY_SECRET=
