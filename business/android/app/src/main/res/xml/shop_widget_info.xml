<?xml version="1.0" encoding="utf-8"?>
<!-- 214 The home-screen widget: 2 × 2 and wider (small and medium). It
     refreshes itself about every 15 minutes (ShopWidget's alarm, below the
     30-minute floor of updatePeriodMillis) and on each new order. With
     several shops, the configuration asks which one. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="tr.com.yallapp.business.ShopWidgetConfigure"
    android:description="@string/widget_description"
    android:initialLayout="@layout/shop_widget"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
